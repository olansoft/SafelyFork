#!/usr/bin/env bash
# safely-fork —— 为指定 GitHub 仓库创建一个"安全的 fork"：
#   1. fork 原仓库
#   2. 把 safely-fork.yml（定时安全同步上游的 workflow）推入 fork
#   3. 在 fork 上启用 GitHub Actions
#   4. 启用 safely-fork workflow（并可选触发一次测试运行）
#
# 依赖：gh（已登录，需要 repo + workflow scope）、jq、base64。
#
# 用法：safely-fork <owner/repo> [选项]
#   --org <org>             fork 到指定组织（默认 fork 到当前账号）
#   --fork-name <name>      重命名 fork（默认：原仓库名-SafelyFork）
#   --workflow-file <path>  要推入的 workflow 文件（默认：本仓库根目录的 safely-fork.yml）
#   --workflow-name <name>  在 fork 中保存的文件名（默认：safely-fork.yml）
#   --dispatch              完成后立即触发一次 workflow 测试运行
#   --set-fork-sync-pat     交互式录入 PAT，保存为 fork 的 secret FORK_SYNC_PAT
#                           （上游合并若改动 .github/workflows/*，同步需要它）
#   --dry-run               只打印将执行的操作，不做任何修改
#   -h, --help              显示帮助

set -euo pipefail

# ---------------------------------------------------------------- 基础设施

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
DEFAULT_WORKFLOW_FILE="$SCRIPT_DIR/../safely-fork.yml"
DEFAULT_WORKFLOW_NAME="safely-fork.yml"

if [ -t 1 ] && [ -z "${NO_COLOR:-}" ]; then
  C_BLUE=$'\033[1;34m'; C_GREEN=$'\033[1;32m'; C_YELLOW=$'\033[1;33m'
  C_RED=$'\033[1;31m'; C_DIM=$'\033[2m'; C_RESET=$'\033[0m'
else
  C_BLUE=""; C_GREEN=""; C_YELLOW=""; C_RED=""; C_DIM=""; C_RESET=""
fi

step()  { printf '%s==> %s%s\n' "$C_BLUE" "$*" "$C_RESET"; }
info()  { printf '  %s\n' "$*"; }
ok()    { printf '%s ✔ %s%s\n' "$C_GREEN" "$*" "$C_RESET"; }
warn()  { printf '%s ⚠ %s%s\n' "$C_YELLOW" "$*" "$C_RESET" >&2; }
die()   { printf '%s ✘ %s%s\n' "$C_RED" "$*" "$C_RESET" >&2; exit 1; }

usage() { sed -n '2,19p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//'; }

usage_die() { usage >&2; exit 1; }

# gh api 包装：任何非 2xx 都带状态码报错退出
api() {
  local method="$1" endpoint="$2"; shift 2
  local out rc
  out=$(gh api -X "$method" "$endpoint" "$@" 2>&1); rc=$?
  if [ $rc -ne 0 ]; then
    # gh api 的错误输出形如 "gh: Not Found (HTTP 404)"
    if [[ "$out" == *"(HTTP 404)"* ]]; then
      API_STATUS=404
    elif [[ "$out" =~ \(HTTP\ ([0-9]+)\) ]]; then
      API_STATUS="${BASH_REMATCH[1]}"
    else
      API_STATUS=0
    fi
    API_ERROR="$out"
    return $rc
  fi
  API_STATUS=0
  API_ERROR=""
  printf '%s' "$out"
}

# ---------------------------------------------------------------- 参数解析

REPO=""
FORK_ORG=""
FORK_NAME=""
WORKFLOW_FILE="$DEFAULT_WORKFLOW_FILE"
WORKFLOW_NAME="$DEFAULT_WORKFLOW_NAME"
DO_DISPATCH=0
SET_PAT=0
DRY_RUN=0

while [ $# -gt 0 ]; do
  case "$1" in
    --org)              FORK_ORG="${2:?--org 需要参数}"; shift 2 ;;
    --fork-name)        FORK_NAME="${2:?--fork-name 需要参数}"; shift 2 ;;
    --workflow-file)    WORKFLOW_FILE="${2:?--workflow-file 需要参数}"; shift 2 ;;
    --workflow-name)    WORKFLOW_NAME="${2:?--workflow-name 需要参数}"; shift 2 ;;
    --dispatch)         DO_DISPATCH=1; shift ;;
    --set-fork-sync-pat) SET_PAT=1; shift ;;
    --dry-run)          DRY_RUN=1; shift ;;
    -h|--help)          usage; exit 0 ;;
    --)                 shift; break ;;
    -*)                 usage_die; printf '\n未知选项: %s\n' "$1" >&2; exit 1 ;;
    *)                  [ -z "$REPO" ] || usage_die; REPO="$1"; shift ;;
  esac
done
[ $# -eq 0 ] || usage_die
[ -n "$REPO" ] || { usage; exit 1; }

# 接受 owner/repo 或完整 URL
REPO="${REPO#https://github.com/}"
REPO="${REPO#http://github.com/}"
REPO="${REPO%.git}"
REPO="${REPO#/}"
[[ "$REPO" == */* ]] || die "仓库格式应为 owner/repo（收到: ${REPO}）"
if [[ "$REPO" == */*/* ]]; then
  die "仓库格式应为 owner/repo（收到: ${REPO}）"
fi

# ---------------------------------------------------------------- 前置检查

step "前置检查"
for cmd in gh jq base64; do
  command -v "$cmd" >/dev/null || die "缺少依赖: $cmd"
done

gh auth status >/dev/null 2>&1 || die "gh 未登录，请先运行: gh auth login（需要 repo + workflow scope）"

if [ ! -f "$WORKFLOW_FILE" ]; then
  die "workflow 文件不存在: $WORKFLOW_FILE"
fi
WORKFLOW_CONTENT_B64=$(base64 < "$WORKFLOW_FILE" | tr -d '\n')

# dry-run 下 fork 归属先用占位值，避免读取用户信息
if [ "$DRY_RUN" -eq 1 ]; then
  FORK_OWNER="${FORK_ORG:-<当前账号>}"
else
  if [ -n "$FORK_ORG" ]; then
    FORK_OWNER="$FORK_ORG"
  else
    FORK_OWNER=$(gh api user --jq .login) || die "获取当前登录账号失败"
  fi
fi
FORK_REPO="${FORK_NAME:-${REPO#*/}-SafelyFork}"
FORK="${FORK_OWNER}/${FORK_REPO}"

ok "凭据与依赖就绪（目标 fork: ${FORK}）"

# ---------------------------------------------------------------- 解析源仓库

step "解析源仓库 $REPO"
if [ "$DRY_RUN" -eq 1 ]; then
  info "[dry-run] 将执行: gh api repos/$REPO"
  SRC_BRANCH="main"
else
  out=$(api GET "repos/$REPO") || {
    [ "$API_STATUS" = "404" ] && die "仓库不存在或无权访问: $REPO"
    die "访问 $REPO 失败: $API_ERROR"
  }
  SRC_BRANCH=$(printf '%s' "$out" | jq -r .default_branch)
  SRC_NAME=$(printf '%s' "$out" | jq -r .name)
  FORK_REPO="${FORK_NAME:-${SRC_NAME}-SafelyFork}"
  FORK="${FORK_OWNER}/${FORK_REPO}"
  ok "源仓库默认分支: $SRC_BRANCH"
fi

# ---------------------------------------------------------------- Fork

step "创建 fork $FORK"
existing=""
if [ "$DRY_RUN" -eq 0 ]; then
  existing=$(api GET "repos/$FORK" 2>/dev/null || true)
fi

if [ -n "$existing" ]; then
  parent=$(printf '%s' "$existing" | jq -r '.parent.full_name // empty')
  if [ "$parent" = "$REPO" ]; then
    ok "fork 已存在且指向 ${REPO}，直接复用"
  else
    die "仓库 $FORK 已存在，但不是 $REPO 的 fork（parent: ${parent:-无}），请换用 --fork-name"
  fi
else
  fork_args=(--clone=false)
  [ -n "$FORK_ORG" ] && fork_args+=(--org "$FORK_ORG") || true
  [ -n "$FORK_NAME" ] && fork_args+=(--fork-name "$FORK_NAME") || true
  if [ "$DRY_RUN" -eq 1 ]; then
    info "[dry-run] 将执行: gh repo fork $REPO ${fork_args[*]}"
  else
    gh repo fork "$REPO" "${fork_args[@]}"
    ok "fork 已创建"
  fi
fi

# ---------------------------------------------------------------- 推送 workflow

WORKFLOW_PATH=".github/workflows/$WORKFLOW_NAME"

step "推送 workflow 到 $FORK:$WORKFLOW_PATH"
if [ "$DRY_RUN" -eq 1 ]; then
  info "[dry-run] 将执行: PUT /repos/$FORK/contents/${WORKFLOW_PATH}（内容来自 ${WORKFLOW_FILE}）"
else
  # fork 创建后默认分支可能与源仓库不同步，以 fork 实际默认分支为准
  out=$(api GET "repos/$FORK") || die "访问 fork $FORK 失败: $API_ERROR"
  FORK_BRANCH=$(printf '%s' "$out" | jq -r .default_branch)

  existing_sha=$(api GET "repos/$FORK/contents/$WORKFLOW_PATH?ref=$FORK_BRANCH" 2>/dev/null | jq -r '.sha // empty' || true)

  put_args=(-f message="chore: add safely-fork sync workflow" -f content="$WORKFLOW_CONTENT_B64" -f branch="$FORK_BRANCH")
  if [ -n "$existing_sha" ]; then
    put_args+=(-f sha="$existing_sha")
  fi

  api PUT "repos/$FORK/contents/$WORKFLOW_PATH" "${put_args[@]}" >/dev/null || {
    if [[ "$API_ERROR" == *"workflow"* ]] || [ "$API_STATUS" = "422" ]; then
      warn "推送失败（${API_STATUS}）。当前 gh 令牌可能缺少 workflow scope，请运行: gh auth refresh -s workflow 后重试"
    fi
    die "推送 workflow 失败: $API_ERROR"
  }
  [ -n "$existing_sha" ] && ok "workflow 已更新" || ok "workflow 已创建"
fi

# ---------------------------------------------------------------- 启用 Actions

step "在 fork 上启用 Actions"
if [ "$DRY_RUN" -eq 1 ]; then
  info "[dry-run] 将执行: PUT /repos/$FORK/actions/permissions {enabled: true}"
else
  api PUT "repos/$FORK/actions/permissions" -F enabled=true -f allowed_actions=all >/dev/null || {
    warn "启用 Actions 失败（HTTP ${API_STATUS}）。个人 fork 一般可成功；组织 fork 可能受组织策略限制。"
    die "$API_ERROR"
  }
  ok "Actions 已启用"
fi

# ---------------------------------------------------------------- 启用 workflow

step "启用 workflow $WORKFLOW_NAME"
if [ "$DRY_RUN" -eq 1 ]; then
  info "[dry-run] 将执行: PUT /repos/$FORK/actions/workflows/$WORKFLOW_NAME/enable"
else
  # 刚推送的 workflow 需要几秒才会注册，轮询等待
  registered=0
  for _ in 1 2 3 4 5 6; do
    if api GET "repos/$FORK/actions/workflows/$WORKFLOW_NAME" >/dev/null 2>&1; then
      registered=1; break
    fi
    info "等待 workflow 注册…"; sleep 5
  done
  [ "$registered" -eq 1 ] || die "workflow $WORKFLOW_NAME 未在 GitHub 上注册成功，请到 Actions 页面手动排查"

  api PUT "repos/$FORK/actions/workflows/$WORKFLOW_NAME/enable" >/dev/null || die "启用 workflow 失败: $API_ERROR"

  state=$(api GET "repos/$FORK/actions/workflows/$WORKFLOW_NAME" | jq -r .state)
  [ "$state" = "active" ] || warn "workflow 状态为 ${state}（预期 active），请到 Actions 页面确认"
  ok "workflow 已启用（state: ${state}）"
fi

# ---------------------------------------------------------------- 可选步骤

if [ "$DO_DISPATCH" -eq 1 ]; then
  step "触发一次测试运行"
  if [ "$DRY_RUN" -eq 1 ]; then
    info "[dry-run] 将执行: POST /repos/$FORK/actions/workflows/$WORKFLOW_NAME/dispatches {ref: $SRC_BRANCH}"
  else
    api POST "repos/$FORK/actions/workflows/$WORKFLOW_NAME/dispatches" -f ref="$FORK_BRANCH" >/dev/null \
      || die "触发运行失败: $API_ERROR"
    ok "已触发，运行状态见 https://github.com/$FORK/actions"
  fi
fi

if [ "$SET_PAT" -eq 1 ]; then
  step "配置 FORK_SYNC_PAT"
  if [ "$DRY_RUN" -eq 1 ]; then
    info "[dry-run] 将提示输入 PAT 并执行: gh secret set FORK_SYNC_PAT -R $FORK"
  else
    printf '请粘贴 classic PAT（至少 repo + workflow scope，输入不回显）: '
    read -rs PAT
    printf '\n'
    [ -n "$PAT" ] || die "PAT 为空，跳过"
    gh secret set FORK_SYNC_PAT -R "$FORK" --body "$PAT" \
      || die "写入 secret 失败（令牌可能缺少 admin:repo / secret 写入权限）"
    ok "FORK_SYNC_PAT 已保存为 fork 的 secret"
  fi
fi

# ---------------------------------------------------------------- 完成

printf '\n'
if [ "$DRY_RUN" -eq 1 ]; then
  ok "dry-run 完成，未做任何修改"
else
  ok "Safely fork 就绪: https://github.com/$FORK"
  printf '  %s上游同步: 每小时第 17 分自动运行，也可手动触发%s\n' "$C_DIM" "$C_RESET"
  printf '  %s建议: 若上游可能改动 .github/workflows/*，请配置 FORK_SYNC_PAT%s\n' "$C_DIM" "$C_RESET"
  printf '  %s      （重跑本工具加 --set-fork-sync-pat，或在仓库 Settings 中手动添加）%s\n' "$C_DIM" "$C_RESET"
fi
